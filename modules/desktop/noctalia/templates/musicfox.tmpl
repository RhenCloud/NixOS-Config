# go-musicfox 自定义主题，由 noctalia 按当前壁纸调色板渲染。
# 放置于 ~/.config/go-musicfox/themes/，由 config.toml 的 activeTheme 选中。
name = "Noctalia"
description = "Noctalia 壁纸取色主题"

[dark]
primary = "{{colors.primary.default.hex}}"
secondary = "{{colors.secondary.default.hex}}"
accent = "{{colors.tertiary.default.hex}}"
success = "{{colors.terminal_normal_green.default.hex}}"
warning = "{{colors.terminal_normal_yellow.default.hex}}"
error = "{{colors.error.default.hex}}"
info = "{{colors.terminal_normal_cyan.default.hex}}"
muted = "{{colors.surface_variant.default.hex}}"
hintKey = "{{colors.on_surface_variant.default.hex}}"
background = "{{colors.surface.default.hex}}"
foreground = "{{colors.on_surface.default.hex}}"
border = "{{colors.outline.default.hex}}"
surface = "{{colors.surface_container.default.hex}}"

[dark.highlights]
menuTitle = "{{colors.primary.default.hex}}"
menuItem = "{{colors.on_surface.default.hex}}"
selectedItem = "{{colors.primary.default.hex}}"
menuItemHover = "{{colors.tertiary.default.hex}}"
selectedItemHover = "{{colors.primary.default.hex}}"
title = "{{colors.primary.default.hex}}"
prompt = "{{colors.primary.default.hex}}"
backButton = "{{colors.on_surface_variant.default.hex}}"
backButtonHover = "{{colors.tertiary.default.hex}}"
subtitle = "{{colors.on_surface_variant.default.hex}}"
progressEmpty = "{{colors.surface_variant.default.hex}}"
scrollTrack = "{{colors.surface_container.default.hex}}"
scrollThumb = "{{colors.surface_variant.default.hex}}"
button = "{{colors.primary.default.hex}}"
buttonBlurred = "{{colors.on_surface_variant.default.hex}}"

[dark.popup]
surface = "{{colors.surface_container_high.default.hex}}"
border = "{{colors.outline.default.hex}}"

[dark.notification]
surface = "{{colors.surface_container_high.default.hex}}"
infoBorder = "{{colors.terminal_normal_cyan.default.hex}}"
successBorder = "{{colors.terminal_normal_green.default.hex}}"
warningBorder = "{{colors.terminal_normal_yellow.default.hex}}"
errorBorder = "{{colors.error.default.hex}}"

[dark.statusBar]
bar = "{{colors.surface_container.default.hex}}"
text = "{{colors.on_surface_variant.default.hex}}"
breadcrumbSep = "{{colors.surface_variant.default.hex}}"
breadcrumbHover = "{{colors.tertiary.default.hex}}"
breadcrumbClick = "{{colors.primary.default.hex}}"
nugget = "{{colors.on_surface.default.hex}}"
nuggetLabel = "{{colors.primary.default.hex}}"

[dark.markdown]
dark = "dark"
light = "light"

[dark.app]
lyricActive = "{{colors.terminal_normal_cyan.default.hex}}"
lyricTransition = "{{colors.primary.default.hex}}"
lyricInactive = "{{colors.surface_variant.default.hex}}"
lyricHighlight = "{{colors.on_surface.default.hex}}"
playbarMode = "{{colors.primary.default.hex}}"
playbarVolume = "{{colors.terminal_normal_cyan.default.hex}}"
playbarPlaying = "{{colors.terminal_normal_green.default.hex}}"
playbarPaused = "{{colors.terminal_normal_yellow.default.hex}}"
