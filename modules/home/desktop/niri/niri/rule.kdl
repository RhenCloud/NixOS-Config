window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    default-column-width {}

    // prefer-no-csd
    // 圆角
    geometry-corner-radius 20
    // 剪掉圆角外的窗口内容
    clip-to-geometry true
    // 透明度
    opacity 0.95
    // 禁止边框画到窗口后面
    draw-border-with-background false

    // Clips window contents to the rounded corner boundaries.
    // clip-to-geometry true

}

blur {
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

window-rule {
    match app-id="musicofx"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 700; }
    // default-floating-position x=32 y=32 relative-to="bottom"
}

window-rule {
    match app-id="clipse"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id="io.github.waylyrics.Waylyrics"
    open-floating true
    focus-ring {
        off
        width 2
    }
    default-floating-position x=32 y=32 relative-to="bottom"
}

window-rule {
    match app-id="nwg-clipman"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 700; }
    default-floating-position x=32 y=32 relative-to="bottom"
}

window-rule {
    match app-id="wechat"
    block-out-from "screencast"
}

window-rule {
    match app-id="vesktop"
    block-out-from "screencast"
}

window-rule {
    match app-id="thunar" title="重命名 .*"
    open-floating true
}

window-rule {
  match app-id="dev.zed.Zed"
  open-maximized true
}

window-rule {
    match app-id="io.github.waylyrics.Waylyrics"
    mouse-passthrough true
    pin true
}

// window-rule {
//     match app-id="some-app"
//     open-floating true
//     pin true
// }

layer-rule {
    match namespace="^noctalia-*"
    background-effect {
        xray false
    }
}

layer-rule {
  // noctalia v5 renders the wallpaper on the `noctalia-wallpaper` /
  // `noctalia-backdrop` layers (v4 used `noctalia-overview`). Keep placing it
  // within niri's backdrop so it shows behind windows / in the overview.
  match namespace="^noctalia-(wallpaper|backdrop)"
  place-within-backdrop true
}

layer-rule {
  match namespace="^awww-daemon$"
  place-within-backdrop true
}

// layer-rule {
//   match namespace="^noctalia-notification$"
//   block-out-from "screencast"
//   place-within-backdrop true
// }

workspace "scratch"
