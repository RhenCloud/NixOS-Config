global {
    tproxy_port: 1536
    tproxy_port_protect: true
    log_level: warn
    wan_interface: auto
    auto_config_kernel_parameter: true
    dial_mode: domain
    allow_insecure: false
    check_interval: 300s
}

subscription {
    main_sub: 'https://sub01.sh-cloudflare.sbs:8443/api/v1/client/subscribe?token=4478e7b769467bfa8d6dde425475c879'
    minor_sub: 'https://sub01.sh-cloudflare.sbs:8443/api/v1/client/subscribe?token=4478e7b769467bfa8d6dde425475c879'
    extra_sub: 'https://sub01.sh-cloudflare.sbs:8443/api/v1/client/subscribe?token=4478e7b769467bfa8d6dde425475c879'
}

dns {
    upstream {
        alidns: 'udp://223.5.5.5:53'
        dnspod: 'udp://119.29.29.29:53'
    }
    routing {
        request {
            qname(geosite:cn) -> alidns
            fallback: dnspod
        }
    }
}

group {
    all_proxy {
        policy: min_moving_avg
    }

    hongkong {
        filter: name(regex: '(港|HK|hk|Hong Kong|HongKong|hongkong)')
        policy: min_moving_avg
    }

    taiwan {
        filter: name(regex: '(台|新北|彰化|TW|Taiwan)')
        policy: min_moving_avg
    }

    singapore {
        filter: name(regex: '(新加坡|坡|狮城|SG|Singapore)')
        policy: min_moving_avg
    }

    japan {
        filter: name(regex: '(日本|川日|东京|大阪|泉日|埼玉|沪日|深日|JP|Japan)')
        policy: min_moving_avg
    }

    united_states {
        filter: name(regex: '(美|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|US|United States)')
        policy: min_moving_avg
    }

}

routing {
    pname(NetworkManager) -> direct
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    dip(geoip:private) -> direct

    domain(geosite:category-ads-all) -> block

    domain(geosite:bilibili) -> direct
    domain(geosite:steam) -> direct
    domain(geosite:apple) -> direct
    domain(geosite:microsoft) -> direct

    domain(geosite:bing) -> all_proxy
    domain(geosite:telegram) -> all_proxy
    domain(geosite:discord) -> all_proxy
    domain(geosite:spotify) -> all_proxy
    domain(geosite:tiktok) -> all_proxy
    domain(geosite:youtube) -> all_proxy
    domain(geosite:netflix) -> all_proxy
    domain(geosite:google) -> all_proxy
    domain(geosite:googlefcm) -> all_proxy
    domain(geosite:facebook) -> all_proxy
    domain(geosite:openai) -> all_proxy
    domain(geosite:github) -> all_proxy
    domain(geosite:twitter) -> all_proxy

    dip(geoip:cn) -> direct
    domain(geosite:cn) -> direct

        fallback: all_proxy
}
